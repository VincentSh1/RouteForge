      "targets": [
        { "editorMode": "code", "expr": "sum by (from_provider, to_provider, reason) (rate(routeforge_fallbacks_total[$__rate_interval]))", "legendFormat": "{{from_provider}} → {{to_provider}} · {{reason}}", "range": true, "refId": "A" }
      ],
      "title": "Fallback events / sec",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "routeforge-prometheus" },
      "description": "Fallback transitions in the selected dashboard range. Counters may reset when RouteForge restarts; increase() handles resets.",
      "fieldConfig": { "defaults": { "decimals": 0, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 34 },
      "id": 24,
      "options": { "displayMode": "gradient", "minVizHeight": 10, "minVizWidth": 0, "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true, "valueMode": "color" },
      "targets": [
        { "editorMode": "code", "expr": "sum by (from_provider, to_provider, reason) (increase(routeforge_fallbacks_total[$__range]))", "instant": true, "legendFormat": "{{from_provider}} → {{to_provider}} · {{reason}}", "range": false, "refId": "A" }
      ],
      "title": "Fallback paths in selected range",
      "type": "bargauge"
    },
