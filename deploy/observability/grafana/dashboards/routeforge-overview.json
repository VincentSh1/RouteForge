      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 16 },
      "id": 13,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, provider, streaming) (rate(routeforge_provider_duration_seconds_bucket{provider=~\"$provider\",streaming=~\"$streaming\"}[$__rate_interval])))", "legendFormat": "{{provider}} stream={{streaming}}", "range": true, "refId": "A" }
      ],
      "title": "p95 provider duration",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "routeforge-prometheus" },
      "description": "Median time from streaming provider attempt start to first non-empty assistant content.",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "id": 14,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "histogram_quantile(0.50, sum by (le, provider) (rate(routeforge_provider_ttfc_seconds_bucket{provider=~\"$provider\"}[$__rate_interval])))", "legendFormat": "{{provider}}", "range": true, "refId": "A" }
      ],
      "title": "p50 streaming TTFC",
