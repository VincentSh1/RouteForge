      "title": "Failures & fallback",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "routeforge-prometheus" },
      "description": "Operational provider outcomes. Success means provider completion, not semantic answer quality.",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 34 },
      "id": 22,
      "options": { "legend": { "calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum by (provider, outcome) (rate(routeforge_provider_attempts_total{provider=~\"$provider\",streaming=~\"$streaming\"}[$__rate_interval]))", "legendFormat": "{{provider}} · {{outcome}}", "range": true, "refId": "A" }
      ],
      "title": "Provider outcomes / sec",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "routeforge-prometheus" },
      "description": "Actual moves from a failed provider attempt to a subsequent provider attempt, grouped by bounded path and reason.",
