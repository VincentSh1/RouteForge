    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "id": 16,
      "panels": [],
      "title": "Routing",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "routeforge-prometheus" },
      "description": "Initial provider selection rate. A request contributes once, before any fallback.",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 25 },
      "id": 17,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum by (provider) (rate(routeforge_routing_selections_total{provider=~\"$provider\",routing_policy=~\"$routing_policy\",streaming=~\"$streaming\"}[$__rate_interval]))", "legendFormat": "{{provider}}", "range": true, "refId": "A" }
      ],
      "title": "Initial selections / sec",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "routeforge-prometheus" },
      "description": "Share of initial selections by provider for the selected policy and mode.",
      "fieldConfig": { "defaults": { "max": 100, "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 25 },
      "id": 18,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "100 * sum by (provider) (rate(routeforge_routing_selections_total{provider=~\"$provider\",routing_policy=~\"$routing_policy\",streaming=~\"$streaming\"}[$__rate_interval])) / scalar(clamp_min(sum(rate(routeforge_routing_selections_total{provider=~\"$provider\",routing_policy=~\"$routing_policy\",streaming=~\"$streaming\"}[$__rate_interval])), 1e-9))", "legendFormat": "{{provider}}", "range": true, "refId": "A" }
      ],
      "title": "Initial selection share",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "routeforge-prometheus" },
      "description": "Actual provider attempt rate. This can exceed initial selections because fallback creates additional attempts.",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 25 },
      "id": 19,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum by (provider) (rate(routeforge_provider_attempts_total{provider=~\"$provider\",streaming=~\"$streaming\"}[$__rate_interval]))", "legendFormat": "{{provider}}", "range": true, "refId": "A" }
      ],
      "title": "Actual attempts / sec",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "routeforge-prometheus" },
      "description": "Request throughput by configured routing policy. The dashboard remains observational and cannot change policy.",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 25 },
      "id": 20,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum by (routing_policy) (rate(routeforge_requests_total{routing_policy=~\"$routing_policy\",streaming=~\"$streaming\"}[$__rate_interval]))", "legendFormat": "{{routing_policy}}", "range": true, "refId": "A" }
      ],
      "title": "Requests / sec by policy",
      "type": "timeseries"
    },
    {
      "collapsed": false,
