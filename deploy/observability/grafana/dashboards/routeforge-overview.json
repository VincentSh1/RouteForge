{
  "annotations": {
    "list": []
  },
  "description": "Operational traffic, latency, fallback, circuit, token, and configured-cost signals for RouteForge. Counters reset when RouteForge restarts.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "routeforge-prometheus" },
      "description": "Current RouteForge request throughput for the selected policy and mode.",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "editorMode": "code", "expr": "sum(rate(routeforge_requests_total{routing_policy=~\"$routing_policy\",streaming=~\"$streaming\"}[$__rate_interval]))", "legendFormat": "requests/s", "range": true, "refId": "A" }
      ],
      "title": "Request rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "routeforge-prometheus" },
      "description": "Successful request rate divided by total request rate. No traffic displays 0 rather than infinity.",
      "fieldConfig": { "defaults": { "max": 100, "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "editorMode": "code", "expr": "100 * sum(rate(routeforge_requests_total{outcome=\"success\",routing_policy=~\"$routing_policy\",streaming=~\"$streaming\"}[$__rate_interval])) / clamp_min(sum(rate(routeforge_requests_total{routing_policy=~\"$routing_policy\",streaming=~\"$streaming\"}[$__rate_interval])), 1e-9)", "legendFormat": "success", "range": true, "refId": "A" }
      ],
      "title": "Success rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "routeforge-prometheus" },
      "description": "Actual fallback transitions divided by all RouteForge requests. The fallback metric has no policy/mode labels, so this panel intentionally uses all traffic.",
      "fieldConfig": { "defaults": { "max": 100, "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "editorMode": "code", "expr": "100 * sum(rate(routeforge_fallbacks_total[$__rate_interval])) / clamp_min(sum(rate(routeforge_requests_total[$__rate_interval])), 1e-9)", "legendFormat": "fallbacks / requests", "range": true, "refId": "A" }
      ],
      "title": "Fallback rate (all traffic)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "routeforge-prometheus" },
      "description": "Configured estimated cost observed during the selected range. This is not provider invoice cost and can omit attempts without an estimate.",
      "fieldConfig": { "defaults": { "decimals": 4, "unit": "currencyUSD" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "id": 5,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "editorMode": "code", "expr": "sum(increase(routeforge_estimated_cost_micro_usd_total{provider=~\"$provider\"}[$__range])) / 1000000", "instant": true, "legendFormat": "estimated USD", "range": false, "refId": "A" }
      ],
      "title": "Estimated cost in selected range",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "routeforge-prometheus" },
      "description": "Authoritative provider-reported input tokens observed during the selected range.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "id": 6,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "editorMode": "code", "expr": "sum(increase(routeforge_tokens_total{direction=\"input\",provider=~\"$provider\"}[$__range]))", "instant": true, "legendFormat": "input tokens", "range": false, "refId": "A" }
      ],
      "title": "Input tokens in selected range",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "routeforge-prometheus" },
      "description": "Authoritative provider-reported output tokens observed during the selected range.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "id": 7,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "editorMode": "code", "expr": "sum(increase(routeforge_tokens_total{direction=\"output\",provider=~\"$provider\"}[$__range]))", "instant": true, "legendFormat": "output tokens", "range": false, "refId": "A" }
      ],
      "title": "Output tokens in selected range",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 8,
      "panels": [],
      "title": "Request performance",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "routeforge-prometheus" },
      "description": "Median full RouteForge request duration. Streaming duration is the complete downstream stream lifetime, not TTFC.",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "id": 9,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "histogram_quantile(0.50, sum by (le, streaming) (rate(routeforge_request_duration_seconds_bucket{routing_policy=~\"$routing_policy\",streaming=~\"$streaming\"}[$__rate_interval])))", "legendFormat": "streaming={{streaming}}", "range": true, "refId": "A" }
      ],
      "title": "p50 request duration",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "routeforge-prometheus" },
      "description": "95th-percentile full RouteForge request duration by request mode.",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "id": 10,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, streaming) (rate(routeforge_request_duration_seconds_bucket{routing_policy=~\"$routing_policy\",streaming=~\"$streaming\"}[$__rate_interval])))", "legendFormat": "streaming={{streaming}}", "range": true, "refId": "A" }
      ],
      "title": "p95 request duration",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 11,
      "panels": [],
      "title": "Provider performance",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "routeforge-prometheus" },
      "description": "Median complete provider invocation lifetime, including upstream stream lifetime for streaming attempts.",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 16 },
      "id": 12,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "histogram_quantile(0.50, sum by (le, provider, streaming) (rate(routeforge_provider_duration_seconds_bucket{provider=~\"$provider\",streaming=~\"$streaming\"}[$__rate_interval])))", "legendFormat": "{{provider}} stream={{streaming}}", "range": true, "refId": "A" }
      ],
      "title": "p50 provider duration",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "routeforge-prometheus" },
