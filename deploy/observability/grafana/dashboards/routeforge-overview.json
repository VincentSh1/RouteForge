    },
    {
      "datasource": { "type": "prometheus", "uid": "routeforge-prometheus" },
      "description": "95th-percentile time to first non-empty assistant content. This is not total stream duration.",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "id": 15,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(routeforge_provider_ttfc_seconds_bucket{provider=~\"$provider\"}[$__rate_interval])))", "legendFormat": "{{provider}}", "range": true, "refId": "A" }
      ],
      "title": "p95 streaming TTFC",
